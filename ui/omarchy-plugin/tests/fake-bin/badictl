#!/usr/bin/env bash

set -euo pipefail

scenario=${BADI_FAKE_SCENARIO:-healthy}

if [[ -n ${BADI_FAKE_CALL_LOG:-} ]]; then
  printf '%s\n' "$*" >>"$BADI_FAKE_CALL_LOG"
fi

# Stand in for a wedged badictl: ignore TERM, record the PID and wait for KILL.
hang_ignoring_term() {
  trap '' TERM
  if [[ -n ${BADI_FAKE_PID_LOG:-} ]]; then
    printf '%s\n' "$$" >>"$BADI_FAKE_PID_LOG"
  fi
  exec sleep 300
}

if [[ ${1:-} == overview && ${2:-} == --json ]]; then
  if [[ -n ${BADI_FAKE_HOLD_OVERVIEW:-} && -f $BADI_FAKE_HOLD_OVERVIEW ]]; then
    trap '' TERM
    exec sleep 300
  fi
  if [[ -n ${BADI_FAKE_FAIL_OVERVIEW:-} && -f $BADI_FAKE_FAIL_OVERVIEW ]]; then
    printf 'badictl: broker unavailable\n' >&2
    exit 1
  fi
  case "$scenario" in
  term-ignoring) hang_ignoring_term ;;
  healthy) ;;
  *)
    printf 'unknown fake scenario: %s\n' "$scenario" >&2
    exit 64
    ;;
  esac

  all_web_origins=false
  [[ ${BADI_FAKE_ALL_WEB_ORIGINS:-} == 1 ]] && all_web_origins=true
  # Further settings keys, read on every call so a test can change them.
  extra='{}'
  if [[ -n ${BADI_FAKE_SETTINGS:-} && -f $BADI_FAKE_SETTINGS ]]; then
    extra=$(cat -- "$BADI_FAKE_SETTINGS")
  fi
  overview_extra='{}'
  if [[ -n ${BADI_FAKE_OVERVIEW:-} && -f $BADI_FAKE_OVERVIEW ]]; then
    overview_extra=$(cat -- "$BADI_FAKE_OVERVIEW")
  fi
  if [[ -n ${BADI_FAKE_STATE_FILE:-} && -f $BADI_FAKE_STATE_FILE ]]; then
    jq --argjson overview_extra "$overview_extra" '. + $overview_extra' "$BADI_FAKE_STATE_FILE"
    exit 0
  fi

  jq -n --argjson all_web_origins "$all_web_origins" --argjson extra "$extra" \
    --argjson overview_extra "$overview_extra" '
    {
      schema: "badi.overview.v2",
      broker: {
        reachable: true,
        provider: "phrase_v1",
        paused: false,
        authority_epoch: 11,
        settings_revision: 7,
        control_plane_degraded: false,
        sessions: 0,
        socket_mode: "0600",
        max_frame_bytes: 65536
      },
      settings: ((if $all_web_origins then {all_web_origins: true} else {} end) + {
        schema: "badi.settings.v2",
        revision: 7,
        paused: false,
        language_overrides: {"brave-origin": "de"},
        subjects: [
          {
            identity: {
              kind: "browser_origin",
              adapter: "chromium",
              scheme: "https",
              host: "example.com",
              port: 443
            },
            permissions: {
              suggest: "allow",
              display: "allow",
              context_read: "allow",
              learn: "block",
              retention: {mode: "none"}
            }
          },
          {
            identity: {
              kind: "linux_app",
              adapter: "fcitx",
              app_id: "omawrite"
            },
            permissions: {
              suggest: "allow",
              display: "allow",
              context_read: "allow",
              learn: "block",
              retention: {mode: "none"}
            }
          }
        ]
      } + $extra)
    } + $overview_extra
  '
  exit 0
fi

if [[ ${1:-} == settings && ${2:-} == replace ]]; then
  if [[ -n ${BADI_FAKE_HOLD_MUTATION:-} && -f $BADI_FAKE_HOLD_MUTATION ]]; then
    hang_ignoring_term
  fi
  [[ ${3:-} == --if-revision && ${5:-} == --json && -n ${4:-} && -n ${6:-} ]]
  [[ $6 == - ]]
  replacement=$(cat)
  printf '%s\n' "$replacement" >"${BADI_FAKE_CALL_LOG}.settings"
  jq -e '
    .schema == "badi.settings.v2"
    and any(.subjects[];
      .identity == {kind: "linux_app", adapter: "fcitx", app_id: "omawrite"})
  ' <<<"$replacement" >/dev/null
  if [[ -n ${BADI_FAKE_STATE_FILE:-} && -f $BADI_FAKE_STATE_FILE ]]; then
    current_rev=$(jq -r '.broker.settings_revision' "$BADI_FAKE_STATE_FILE")
    if [[ $4 != "$current_rev" ]]; then
      printf 'badictl: settings revision conflict (expected %s, current %s)\n' "$4" "$current_rev" >&2
      exit 1
    fi
    next_rev=$((current_rev + 1))
    jq -e --argjson rev "$next_rev" '.revision == $rev' <<<"$replacement" >/dev/null
    jq --argjson rev "$next_rev" --argjson replacement "$replacement" '
      .broker.settings_revision = $rev
      | .broker.paused = ($replacement.paused == true)
      | .settings = $replacement
    ' "$BADI_FAKE_STATE_FILE" >"${BADI_FAKE_STATE_FILE}.next"
    mv -- "${BADI_FAKE_STATE_FILE}.next" "$BADI_FAKE_STATE_FILE"
  fi
  exit 0
fi

printf 'unsupported fake badictl argv\n' >&2
exit 64

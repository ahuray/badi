pkgbase = badi-git
	pkgdesc = Local writing suggestions for Linux, Omarchy first
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/ahuray/badi
	arch = x86_64
	license = MIT
	license = MPL-2.0
	license = Zlib
	license = LicenseRef-SCOWL
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = ninja
	makedepends = nlohmann-json
	depends = gcc-libs
	depends = glibc
	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = at-spi2-core
	depends = gtk4
	depends = gtk4-layer-shell
	depends = glib2
	depends = pango
	depends = systemd
	depends = fcitx5>=5.1.23
	depends = hyprland
	depends = quickshell
	depends = qt6-declarative
	depends = hicolor-icon-theme
	optdepends = curl: download the separately verified writing assets
	optdepends = libsecret: keep the opt-in style-learning key in the desktop keyring
	optdepends = xdg-desktop-portal: pause and settings shortcuts through the desktop portal
	optdepends = pipewire: hold suggestions while the screen is shared (pw-dump)

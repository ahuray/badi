pkgbase = badi-git
	pkgdesc = Local writing suggestions for Linux, Omarchy first
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/ahuray/badi
	arch = x86_64
	license = MIT
	license = MPL-2.0
	license = Zlib
	license = LicenseRef-SCOWL
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = ninja
	makedepends = nlohmann-json
	depends = gcc-libs
	depends = glibc
	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = at-spi2-core
	depends = gtk4
	depends = glib2
	depends = pango
	depends = systemd
	depends = pipewire
	depends = fcitx5>=5.1.23
	depends = hicolor-icon-theme
	optdepends = curl: download the separately verified writing assets
	optdepends = libsecret: keep the opt-in style-learning key in the desktop keyring
	optdepends = gnome-keyring: a Secret Service provider for that key (or KWallet with its Secret Service)
	optdepends = xdg-desktop-portal: pause and settings shortcuts through the desktop portal
	optdepends = hyprland: the field observer session and its grey preview layer
	optdepends = gtk4-layer-shell: the grey preview overlay in a Hyprland session
	optdepends = quickshell: the Omarchy bar settings panel
	optdepends = qt6-declarative: the Omarchy bar settings panel
	provides = badi
	conflicts = badi
	options = !debug
	source = badi::git+https://github.com/ahuray/badi.git#branch=main
	sha256sums = SKIP

pkgname = badi-git

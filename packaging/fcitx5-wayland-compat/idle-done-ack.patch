+void WaylandIMInputContextV2::acknowledgeIdleState() {
+    if (!server_->parent()->idleDoneAcknowledgementEnabled()) {
+        return;
+    }
+    auto *input = delegatedInputContext();
+    // Some text-input clients serialize each publication behind done. An idle
+    // input method otherwise never acknowledges it. A bare protocol commit is
+    // sufficient, but can clear client preedit: never send it while composing.
+    // Delegate operations commit synchronously, so their pending mutation batch
+    // is already flushed; avoid another commit if they acknowledged this serial.
+    if (!realFocus() || committedSerial_ == serial_ || preeditActive_ ||
+        !input->inputPanel().clientPreedit().empty() ||
+        !input->inputPanel().preedit().empty() ||
+        server_->instance()->isComposing(input)) {
+        return;
+    }
+    commitProtocolState();
+}

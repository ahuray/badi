[Unit]
Description=Badi focused field observer and native prediction preview
After=graphical-session.target badi-broker.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_RUNTIME_DIR
# The focused window comes from Hyprland's IPC, a KWin script on KDE Plasma
# (ADR 0015) or Badi's Shell extension on GNOME (ADR 0016); "|" makes any of
# these sessions enough. Ubuntu names its GNOME session ubuntu:GNOME. On
# another desktop systemd skips the observer.
ConditionEnvironment=|HYPRLAND_INSTANCE_SIGNATURE
ConditionEnvironment=|XDG_CURRENT_DESKTOP=KDE
ConditionEnvironment=|XDG_CURRENT_DESKTOP=GNOME
ConditionEnvironment=|XDG_CURRENT_DESKTOP=ubuntu:GNOME
# Keep retrying a transient AT-SPI or session failure. RestartSteps bounds
# the delay; the unit does not stop after three failures.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B %h/.local/lib/badi/accessibility/daemon.py
Restart=on-failure
# 78: the desktop offers no focused-window source (a Plasma older than 6, an
# X11 session); retrying cannot help.
RestartPreventExitStatus=78
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
# AT-SPI, the session bus, Wayland and the broker are local Unix sockets;
# GLib's network monitor uses netlink.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# A core dump would keep the displayed text of the observed field on disk.
LimitCORE=0
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target

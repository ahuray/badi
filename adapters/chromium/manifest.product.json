{
  "manifest_version": 3,
  "name": "Badi (Dillinger product proof)",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "132",
  "incognito": "not_allowed",
  "description": "Optional exact-site writing suggestions for the Dillinger Markdown editor.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://dillinger.io:443/*"
  ],
  "background": {
    "service_worker": "product-service-worker.js"
  },
  "action": {
    "default_title": "Badi Dillinger access",
    "default_popup": "product-access.html"
  },
  "commands": {
    "accept-dillinger-suggestion": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Accept the visible Badi suggestion in the exact Dillinger document"
    }
  }
}

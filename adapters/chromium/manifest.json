{
  "manifest_version": 3,
  "name": "Badi (development slice)",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "132",
  "incognito": "not_allowed",
  "description": "Controlled localhost writing-suggestion slice through the Badi native broker.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4173/chromium.html"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle broker pause state for trusted Badi fixture controllers"
    }
  }
}

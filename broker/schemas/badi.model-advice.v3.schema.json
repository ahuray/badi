{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:badi:schema:model-advice:v3",
  "title": "Badi model advice v3",
  "$comment": "This schema validates structure and candidate/no-fit state. Producer tests enforce cross-field identity, ordering, fit arithmetic, reserve, and download linkage invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "reason",
    "hardware",
    "use_case",
    "tier",
    "recommended",
    "alternatives",
    "rationale",
    "fit",
    "download",
    "runtime_ready",
    "catalog"
  ],
  "properties": {
    "schema": { "const": "badi.model-advice.v3" },
    "status": { "enum": ["candidate", "no_fit"] },
    "reason": {
      "enum": [
        "candidate_fits_host_memory",
        "memory_capacity_unknown",
        "memory_capacity_invalid",
        "insufficient_usable_memory",
        "insufficient_compute",
        "unsupported_architecture"
      ]
    },
    "hardware": { "$ref": "urn:badi:schema:hardware:v1" },
    "use_case": { "$ref": "#/$defs/useCase" },
    "tier": {
      "oneOf": [
        { "$ref": "#/$defs/tier" },
        { "type": "null" }
      ]
    },
    "recommended": {
      "oneOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "null" }
      ]
    },
    "alternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "uniqueItems": true
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fit": {
      "oneOf": [
        { "$ref": "#/$defs/memoryFit" },
        { "type": "null" }
      ]
    },
    "download": {
      "oneOf": [
        { "$ref": "#/$defs/downloadPlan" },
        { "type": "null" }
      ]
    },
    "runtime_ready": { "const": false },
    "catalog": {
      "description": "Every pinned model for this use, catalog order, each marked whether it fits this device (the recommendation and its alternatives).",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "#/$defs/artifactFields" }],
        "type": "object",
        "required": ["fits"],
        "properties": { "fits": { "type": "boolean" } },
        "unevaluatedProperties": false
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "candidate" },
        "reason": { "const": "candidate_fits_host_memory" },
        "tier": { "$ref": "#/$defs/tier" },
        "recommended": { "$ref": "#/$defs/artifact" },
        "fit": { "$ref": "#/$defs/memoryFit" },
        "download": { "$ref": "#/$defs/downloadPlan" }
      }
    },
    {
      "properties": {
        "status": { "const": "no_fit" },
        "reason": {
          "enum": [
            "memory_capacity_unknown",
            "memory_capacity_invalid",
            "insufficient_usable_memory",
            "insufficient_compute",
            "unsupported_architecture"
          ]
        },
        "tier": { "type": "null" },
        "recommended": { "type": "null" },
        "alternatives": { "maxItems": 0 },
        "fit": { "type": "null" },
        "download": { "type": "null" }
      }
    }
  ],
  "$defs": {
    "useCase": { "enum": ["writing", "code"] },
    "tier": { "enum": ["compact", "balanced", "quality"] },
    "artifact": {
      "allOf": [{ "$ref": "#/$defs/artifactFields" }],
      "unevaluatedProperties": false
    },
    "artifactFields": {
      "type": "object",
      "required": [
        "id",
        "name",
        "use_case",
        "tier",
        "repository",
        "revision",
        "filename",
        "sha256",
        "download_bytes",
        "quantization",
        "license",
        "runtime",
        "minimum_runtime_version",
        "prompt_format",
        "runtime_caveat",
        "languages",
        "screen_useful",
        "healed_languages"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]{1,64}$" },
        "name": { "type": "string", "minLength": 1 },
        "use_case": { "$ref": "#/$defs/useCase" },
        "tier": { "$ref": "#/$defs/tier" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.gguf$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "download_bytes": { "type": "integer", "minimum": 1 },
        "quantization": { "enum": ["Q8_0", "Q4_K_M"] },
        "license": { "enum": ["Apache-2.0", "Gemma", "Llama-3.2-Community"] },
        "runtime": { "const": "llama.cpp" },
        "minimum_runtime_version": { "type": "string", "pattern": "^b[0-9]+$" },
        "prompt_format": { "type": "string", "minLength": 1 },
        "runtime_caveat": { "type": "string", "minLength": 1 },
        "languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "screen_useful": {
          "description": "Blind-reviewed useful suggestions of 135 development requests in the 2026-10-17 Prediction Lab screen; null when unmeasured. A screening score, not a qualification.",
          "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 135 }, { "type": "null" }]
        },
        "healed_languages": {
          "description": "Languages whose trailing space is healed with this model by default, each promoted by its own blind review; settings trailing_space_healing overrides it per language.",
          "type": "array",
          "items": { "enum": ["en", "de", "fa", "fr", "es"] },
          "uniqueItems": true
        }
      }
    },
    "memoryFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_target",
        "usable_host_memory_mib",
        "artifact_memory_mib",
        "runtime_headroom_mib",
        "required_host_memory_mib"
      ],
      "properties": {
        "execution_target": { "const": "cpu_host_memory" },
        "usable_host_memory_mib": { "type": "integer", "minimum": 0 },
        "artifact_memory_mib": { "type": "integer", "minimum": 1 },
        "runtime_headroom_mib": { "type": "integer", "minimum": 1 },
        "required_host_memory_mib": { "type": "integer", "minimum": 1 }
      }
    },
    "downloadPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "arguments", "expected_sha256"],
      "properties": {
        "tool": { "const": "hf" },
        "arguments": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "const": "download" },
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 },
            { "const": "--revision" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "const": "--local-dir" },
            { "const": "~/.local/share/badi/models" }
          ],
          "items": false
        },
        "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

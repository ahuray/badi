{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:badi:schema:settings:v1",
  "title": "Badi private settings v1",
  "$comment": "Rust producer validation additionally requires canonical subject ordering, unique identities, canonical host/IP spelling, and permission dependency invariants. Clipboard, screen-capture, and cloud permissions do not exist in v1 and strict decoding rejects them because those capabilities are unsupported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "paused", "subjects"],
  "properties": {
    "schema": { "const": "badi.settings.v1" },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "paused": { "type": "boolean" },
    "subjects": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/subject" }
    }
  },
  "$defs": {
    "decision": {
      "enum": ["allow", "block"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter", "scheme", "host", "port"],
      "properties": {
        "kind": { "const": "browser_origin" },
        "adapter": { "const": "chromium" },
        "scheme": { "enum": ["http", "https"] },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9.:-]+$",
          "description": "Canonical ASCII DNS name or IP literal. Rust validation is normative for label and canonical spelling rules."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Effective port; omitted HTTP/HTTPS ports are stored as 80/443."
        }
      }
    },
    "retention": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "days"],
          "properties": {
            "mode": { "const": "bounded" },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggest", "display", "context_read", "learn", "retention"],
      "properties": {
        "suggest": { "$ref": "#/$defs/decision" },
        "display": { "$ref": "#/$defs/decision" },
        "context_read": { "$ref": "#/$defs/decision" },
        "learn": { "$ref": "#/$defs/decision" },
        "retention": { "$ref": "#/$defs/retention" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "suggest": { "const": "allow" } },
            "required": ["suggest"]
          },
          "then": {
            "properties": {
              "display": { "const": "allow" },
              "context_read": { "const": "allow" }
            }
          }
        },
        {
          "if": {
            "properties": { "learn": { "const": "allow" } },
            "required": ["learn"]
          },
          "then": {
            "properties": {
              "suggest": { "const": "allow" },
              "display": { "const": "allow" },
              "context_read": { "const": "allow" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retention": {
                "type": "object",
                "properties": { "mode": { "const": "bounded" } },
                "required": ["mode"]
              }
            },
            "required": ["retention"]
          },
          "then": {
            "properties": { "learn": { "const": "allow" } }
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "permissions"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "permissions": { "$ref": "#/$defs/permissions" }
      }
    }
  }
}

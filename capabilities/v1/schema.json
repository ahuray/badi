{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badi.invalid/capabilities/v1/schema.json",
  "title": "Badi capability evidence receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "record_version",
    "id",
    "status",
    "recorded_date",
    "protocol",
    "adapter",
    "evidence",
    "scope",
    "protections",
    "exclusions",
    "artifacts",
    "notes"
  ],
  "properties": {
    "$schema": { "const": "./v1/schema.json" },
    "record_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "status": { "enum": ["foundation", "live", "unsupported"] },
    "recorded_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "schema"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "schema": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package",
        "version",
        "target",
        "native_host",
        "manifest",
        "build_manifest"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "native_host": { "type": "string", "minLength": 1 },
        "manifest": { "$ref": "#/$defs/repositoryPath" },
        "build_manifest": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "live_browser",
        "live_native_host",
        "local_environment",
        "ci_toolchains",
        "checks"
      ],
      "properties": {
        "class": { "enum": ["simulated-dom", "live-target"] },
        "live_browser": { "type": "boolean" },
        "live_native_host": { "type": "boolean" },
        "local_environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "ci_toolchains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "status"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "fail", "not-run"] },
              "passed": { "type": "integer", "minimum": 0 },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origins",
        "documents",
        "elements",
        "conditions",
        "display_route",
        "insertion_route",
        "commit_status"
      ],
      "properties": {
        "origins": { "$ref": "#/$defs/stringArray" },
        "documents": { "$ref": "#/$defs/stringArray" },
        "elements": { "$ref": "#/$defs/stringArray" },
        "conditions": { "$ref": "#/$defs/stringArray" },
        "display_route": { "type": "string", "minLength": 1 },
        "insertion_route": { "type": "string", "minLength": 1 },
        "commit_status": { "type": "string", "minLength": 1 }
      }
    },
    "protections": { "$ref": "#/$defs/stringArray" },
    "exclusions": { "$ref": "#/$defs/stringArray" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/repositoryPath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "notes": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$"
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://badi.invalid/capabilities/v3/run.schema.json",
  "title": "Badi product-cell evidence run V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "record_version",
    "id",
    "kind",
    "status",
    "recorded_at",
    "repository",
    "qualification_sha256",
    "environment",
    "hardware",
    "scope",
    "isolation",
    "privacy",
    "checks",
    "measurements",
    "artifacts",
    "manual_attestations",
    "exclusions",
    "notes"
  ],
  "properties": {
    "$schema": { "const": "../v3/run.schema.json" },
    "record_version": { "const": 3 },
    "id": {
      "type": "string",
      "pattern": "^badi-(?:semantic|chromium|omarchy)-run\\.[a-z0-9][a-z0-9-]{0,63}\\.v3$"
    },
    "kind": { "enum": ["semantic", "chromium", "omarchy"] },
    "status": { "enum": ["pass", "fail", "unsupported"] },
    "recorded_at": { "$ref": "#/$defs/utcTimestamp" },
    "repository": { "$ref": "#/$defs/repository" },
    "qualification_sha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "components"],
      "properties": {
        "os": { "$ref": "#/$defs/nonEmpty" },
        "kernel": { "$ref": "#/$defs/nonEmpty" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "$ref": "#/$defs/id" },
              "version": { "$ref": "#/$defs/nonEmpty" },
              "declared_minimum": { "$ref": "#/$defs/nonEmpty" },
              "source_identity": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "themes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "hardware": { "$ref": "#/$defs/hardware" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "target_app",
        "target",
        "target_version",
        "surface",
        "editor_api",
        "language",
        "display_route",
        "insertion_route"
      ],
      "properties": {
        "claim": { "$ref": "#/$defs/nonEmpty" },
        "target_app": { "$ref": "#/$defs/nonEmpty" },
        "target": { "$ref": "#/$defs/nonEmpty" },
        "target_version": { "$ref": "#/$defs/nonEmpty" },
        "surface": { "$ref": "#/$defs/nonEmpty" },
        "editor_api": { "$ref": "#/$defs/nonEmpty" },
        "language": { "const": "en" },
        "display_route": { "$ref": "#/$defs/nonEmpty" },
        "insertion_route": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporary_home",
        "temporary_xdg",
        "temporary_browser_profile",
        "real_browser_profile_touched",
        "user_config_touched",
        "system_files_touched",
        "temporary_tree_removed",
        "processes_remaining"
      ],
      "properties": {
        "temporary_home": { "type": "boolean" },
        "temporary_xdg": { "type": "boolean" },
        "temporary_browser_profile": { "type": "boolean" },
        "real_browser_profile_touched": { "const": false },
        "user_config_touched": { "type": "boolean" },
        "system_files_touched": { "const": false },
        "temporary_tree_removed": { "type": "boolean" },
        "processes_remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_text_recorded",
        "suggestion_text_recorded",
        "prompt_or_token_text_logged",
        "context_fingerprints_recorded",
        "absolute_personal_paths_recorded",
        "secrets_recorded"
      ],
      "properties": {
        "context_text_recorded": { "const": false },
        "suggestion_text_recorded": { "const": false },
        "prompt_or_token_text_logged": { "const": false },
        "context_fingerprints_recorded": { "const": false },
        "absolute_personal_paths_recorded": { "const": false },
        "secrets_recorded": { "const": false }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "measurements": {
      "type": "array",
      "items": { "$ref": "#/$defs/measurement" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "manual_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "recorded_at", "detail"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "not-applicable"] },
          "recorded_at": { "$ref": "#/$defs/utcTimestamp" },
          "detail": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "exclusions": { "$ref": "#/$defs/stringArray" },
    "notes": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "working_tree_dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "working_tree_dirty": { "const": false }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "cpu",
        "logical_cpus",
        "ram_mib",
        "gpu",
        "stable_identity_sha256",
        "displays"
      ],
      "properties": {
        "cell_id": { "$ref": "#/$defs/id" },
        "cpu": { "$ref": "#/$defs/nonEmpty" },
        "logical_cpus": { "type": "integer", "minimum": 1 },
        "ram_mib": { "type": "integer", "minimum": 1 },
        "gpu": { "$ref": "#/$defs/nonEmpty" },
        "stable_identity_sha256": { "$ref": "#/$defs/sha256" },
        "displays": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "width", "height", "scale"],
            "properties": {
              "name": { "$ref": "#/$defs/nonEmpty" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "scale": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "trials", "passed", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "unsupported"] },
        "trials": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "detail": { "$ref": "#/$defs/nonEmpty" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "trials": { "type": "integer", "minimum": 1 },
              "passed": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "samples",
        "warmups",
        "statistic",
        "observations",
        "value",
        "threshold_operator",
        "threshold",
        "status"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "unit": { "$ref": "#/$defs/nonEmpty" },
        "samples": { "type": "integer", "minimum": 1 },
        "warmups": { "type": "integer", "minimum": 0 },
        "statistic": { "$ref": "#/$defs/nonEmpty" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "$comment": "The versioned V3 policy enforces nonnegative domains, binary rates, and the sole signed mean-difference ratio exception.",
          "items": { "type": "number" }
        },
        "numerator": { "type": "number", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "value": { "type": "number" },
        "threshold_operator": {
          "enum": ["at-most", "at-least", "equal", "between"]
        },
        "threshold": { "type": "number" },
        "threshold_max": { "type": "number" },
        "status": { "enum": ["pass", "fail"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "threshold_operator": { "const": "between" } },
            "required": ["threshold_operator"]
          },
          "then": {
            "properties": { "threshold_max": { "type": "number" } },
            "required": ["threshold_max"]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "locator", "bytes", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "locator": { "$ref": "#/$defs/nonEmpty" },
        "repository_path": { "$ref": "#/$defs/repositoryPath" },
        "source_repository": { "$ref": "#/$defs/nonEmpty" },
        "source_artifact": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "license": { "$ref": "#/$defs/nonEmpty" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" },
      "uniqueItems": true
    }
  }
}
